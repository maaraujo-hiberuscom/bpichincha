  return String(value || '')
    .replace(/^(?:TCSBRKR\\d+_BP[-:]?)+/i, '')
    .normalize('NFD')
    .replace(/[\\u0300-\\u036f]/g, '')
    .replace(/\\s+/g, ' ')
    .trim()
    .toLowerCase();
}

