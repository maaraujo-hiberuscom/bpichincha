const body = insomnia.response.text();

function iterationValue(name, fallback = '') {
  try {
    const value = insomnia.iterationData.get(name);
    return value === undefined || value === null
      ? fallback
      : String(value);
  } catch (error) {
    return fallback;
  }
}

function getTagValue(tagName) {
  const expression = new RegExp(
    `<(?:(?:[\\w.-]+):)?${tagName}(?:\\s[^>]*)?>\\s*([^<]*)\\s*<\\/(?:(?:[\\w.-]+):)?${tagName}\\s*>`,
    'i'
  );

  const result = body.match(expression);
  return result ? result[1].trim() : '';
}

function normalizeMessage(value) {
  return String(value || '')
    .replace(/^(?:TCSBRKR\\d+_BP[-:]?)+/i, '')
    .normalize('NFD')
    .replace(/[\\u0300-\\u036f]/g, '')
    .replace(/\\s+/g, ' ')
    .trim()
    .toLowerCase();
}

const caseId = iterationValue('caseId', 'MANUAL');
const expectedCode = iterationValue('expectedCode');
const expectedMessage = iterationValue('expectedMessage');
const expectedType = iterationValue('expectedType');
const expectedBackend = iterationValue('expectedBackend');
const expectEconomicData =
  iterationValue('expectEconomicData') === 'true';

const codigo = getTagValue('codigo');
const mensaje = getTagValue('mensaje');
const tipo = getTagValue('tipo');
const backend = getTagValue('backend');
const recurso = getTagValue('recurso');

const responseCode =
  insomnia.response.code ??
  insomnia.response.status;

insomnia.test(`${caseId} - HTTP 200`, () => {
  insomnia.expect(
    responseCode === 200 ||
    responseCode === '200' ||
    responseCode === 'OK'
  ).to.eql(true);
});

insomnia.test(`${caseId} - Respuesta SOAP`, () => {
  insomnia.expect(body).to.match(
    /<(?:[\w.-]+:)?Envelope(?:\s|>)/i
  );
});

insomnia.test(`${caseId} - Sin SOAP Fault`, () => {
  insomnia.expect(body).not.to.match(
    /<(?:[\w.-]+:)?Fault(?:\s|>)/i
  );
});

insomnia.test(
  `${caseId} - Código ${expectedCode}`,
  () => {
    insomnia.expect(codigo).to.eql(expectedCode);
  }
);

insomnia.test(
  `${caseId} - Mensaje funcional`,
  () => {
    insomnia.expect(
      normalizeMessage(mensaje)
    ).to.eql(
      normalizeMessage(expectedMessage)
    );
  }
);

insomnia.test(
  `${caseId} - Tipo ${expectedType}`,
  () => {
    insomnia.expect(tipo).to.eql(expectedType);
  }
);

insomnia.test(
  `${caseId} - Backend ${expectedBackend}`,
  () => {
    insomnia.expect(backend).to.eql(expectedBackend);
  }
);

if (expectEconomicData) {
  insomnia.test(
    `${caseId} - Datos económicos informados`,
    () => {
      insomnia.expect(body).to.match(
        /<(?:[\w.-]+:)?detalleEconomicos(?:\s|>)/i
      );
    }
  );
}

insomnia.test(
  `${caseId} - Recurso no genérico`,
  () => {
    insomnia.expect(
      recurso.toLowerCase()
    ).not.to.eql('resource');
  }
);


