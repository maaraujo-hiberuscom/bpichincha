const legacyStored =
  insomnia.environment.get(`legacy_${caseId}`);

insomnia.test(
  `${caseId} - Existe resultado Legado`,
  () => {
    insomnia.expect(legacyStored).to.be.a('string');
    insomnia.expect(legacyStored.length).to.be.greaterThan(0);
  }
);

if (legacyStored) {
  const legacyResult = JSON.parse(legacyStored);

  insomnia.test(
    `${caseId} - Código Migrado = Legado`,
    () => {
      insomnia.expect(codigo).to.eql(
        legacyResult.codigo
      );
    }
  );

  insomnia.test(
    `${caseId} - Mensaje Migrado = Legado`,
    () => {
      insomnia.expect(
        normalizeMessage(mensaje)
      ).to.eql(
        legacyResult.mensaje
      );
    }
  );

  insomnia.test(
    `${caseId} - Tipo Migrado = Legado`,
    () => {
      insomnia.expect(tipo).to.eql(
        legacyResult.tipo
      );
    }
  );

  insomnia.test(
    `${caseId} - Backend Migrado = Legado`,
    () => {
      insomnia.expect(backend).to.eql(
