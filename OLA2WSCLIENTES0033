});

response migrado 
const migratedBody = insomnia.response.text();

const legacyBody = insomnia.environment.get(
  'legacy_WSClientes0033_ConsultarDatosEconomicosCliente01'
);

function normalizeXml(xml) {
  return String(xml || '')
    .replace(/>\s+</g, '><')
    .replace(/\r?\n/g, '')
    .trim();
}

insomnia.test('Migrado - Existe baseline Legado', () => {
  insomnia.expect(legacyBody).to.be.a('string');
  insomnia.expect(legacyBody.length).to.be.greaterThan(0);
});

insomnia.test('Migrado - HTTP exitoso', () => {
  const code = insomnia.response.code;
  const status = insomnia.response.status;

  insomnia.expect(
    code === 200 || status === 200 || status === 'OK'
  ).to.eql(true);
});

insomnia.test('Migrado - Código funcional 0', () => {
  insomnia.expect(migratedBody).to.match(
    /<codigo>\s*0\s*<\/codigo>/i
  );
});

insomnia.test('Migrado - Mensaje OK', () => {
  insomnia.expect(migratedBody).to.match(
    /<mensaje>\s*OK\s*<\/mensaje>/i
  );
});

insomnia.test('Migrado - Datos económicos informados', () => {
  insomnia.expect(migratedBody).to.include(
    '<detalleEconomicos>'
  );
  insomnia.expect(migratedBody).to.include('<ingresos>');
  insomnia.expect(migratedBody).to.include('<egresos>');
  insomnia.expect(migratedBody).to.include('<estado>');
});

insomnia.test('Legado y Migrado - XML equivalente', () => {
  insomnia.expect(
    normalizeXml(migratedBody)
  ).to.eql(
    normalizeXml(legacyBody)
  );
});
