const config = {
  caseId: 'EP-003',
  expectedCode: '1',
  expectedMessage: 'Valor del campo cif vacío o inválido',
  expectedType: 'ERROR',
  expectedBackend: '00638'
};

const body = insomnia.response.text();

function getTagValue(tagName) {
  const regex = new RegExp(
    `<(?:(?:[\\w.-]+):)?${tagName}(?:\\s[^>]*)?>` +
    `\\s*([^<]*)\\s*` +
    `<\\/(?:(?:[\\w.-]+):)?${tagName}\\s*>`,
    'i'
  );

  const result = body.match(regex);
  return result ? result[1].trim() : '';
}

function normalizeMessage(value) {
  return String(value || '')
    .replace(/^(?:TCSBRKR\\d+_BP[-:]?)+/i, '')
    .normalize('NFD')
    .replace(/[\\u0300-\\u036f]/g, '')
    .replace(/\\s+/g, ' ')
    .trim()
    .toLowerCase();
}

const codigo = getTagValue('codigo');
const mensaje = getTagValue('mensaje');
const tipo = getTagValue('tipo');
const backend = getTagValue('backend');
const recurso = getTagValue('recurso');

const status =
  insomnia.response.code ??
  insomnia.response.status;

insomnia.test(`${config.caseId} - HTTP exitoso`, () => {
  insomnia.expect(
    status === 200 ||
    status === '200' ||
    status === 'OK'
  ).to.eql(true);
});

insomnia.test(`${config.caseId} - Respuesta SOAP`, () => {
  insomnia.expect(body).to.match(
    /<(?:[\w.-]+:)?Envelope(?:\s|>)/i
  );
});

insomnia.test(`${config.caseId} - Sin SOAP Fault`, () => {
  insomnia.expect(body).not.to.match(
    /<(?:[\w.-]+:)?Fault(?:\s|>)/i
  );
});

insomnia.test(
  `${config.caseId} - Código ${config.expectedCode}`,
  () => {
    insomnia.expect(codigo).to.eql(
      config.expectedCode
    );
  }
);

insomnia.test(
  `${config.caseId} - Mensaje esperado`,
  () => {
    insomnia.expect(
      normalizeMessage(mensaje)
    ).to.eql(
      normalizeMessage(config.expectedMessage)
    );
  }
);

insomnia.test(
  `${config.caseId} - Tipo ${config.expectedType}`,
  () => {
    insomnia.expect(tipo).to.eql(
      config.expectedType
    );
  }
);

insomnia.test(
  `${config.caseId} - Backend ${config.expectedBackend}`,
  () => {
    insomnia.expect(backend).to.eql(
      config.expectedBackend
    );
  }
);

insomnia.test(
  `${config.caseId} - Recurso informado`,
  () => {
    insomnia.expect(recurso).to.be.a('string');
    insomnia.expect(recurso.length).to.be.greaterThan(0);
  }
);
