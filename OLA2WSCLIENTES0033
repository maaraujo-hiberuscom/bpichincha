const body = insomnia.response.text();

function getData(name) {
  const value = insomnia.iterationData.get(name);

  if (value === undefined || value === null) {
    return '';
  }

  return String(value);
}

function getTagValue(tagName) {
  const regex = new RegExp(
    `<(?:(?:[\\w.-]+):)?${tagName}(?:\\s[^>]*)?>` +
    `\\s*([^<]*)\\s*` +
    `<\\/(?:(?:[\\w.-]+):)?${tagName}\\s*>`,
    'i'
  );

  const result = body.match(regex);
  return result ? result[1].trim() : '';
}

function normalizeMessage(value) {
  return String(value || '')
    .replace(/^(?:TCSBRKR\\d+_BP[-:]?)+/i, '')
    .normalize('NFD')
    .replace(/[\\u0300-\\u036f]/g, '')
    .replace(/\\s+/g, ' ')
    .trim()
    .toLowerCase();
}

const caseId = getData('caseId');
const expectedCode = getData('expectedCode');
const expectedMessage = getData('expectedMessage');
const expectedType = getData('expectedType');

const codigo = getTagValue('codigo');
const mensaje = getTagValue('mensaje');
const tipo = getTagValue('tipo');
const backend = getTagValue('backend');

const httpStatus =
  insomnia.response.code ??
  insomnia.response.status;

insomnia.test(`${caseId} - HTTP exitoso`, () => {
  insomnia.expect(
    httpStatus === 200 ||
    httpStatus === '200' ||
    httpStatus === 'OK'
  ).to.eql(true);
});

insomnia.test(`${caseId} - Es respuesta SOAP`, () => {
  insomnia.expect(body).to.match(
    /<(?:[\w.-]+:)?Envelope(?:\s|>)/i
  );
});

insomnia.test(`${caseId} - Sin SOAP Fault`, () => {
  insomnia.expect(body).not.to.match(
    /<(?:[\w.-]+:)?Fault(?:\s|>)/i
  );
});

insomnia.test(
  `${caseId} - Código esperado ${expectedCode}`,
  () => {
    insomnia.expect(codigo).to.eql(expectedCode);
  }
);

insomnia.test(
  `${caseId} - Mensaje esperado`,
  () => {
    insomnia.expect(
      normalizeMessage(mensaje)
    ).to.eql(
      normalizeMessage(expectedMessage)
    );
  }
);

insomnia.test(
  `${caseId} - Tipo esperado ${expectedType}`,
  () => {
    insomnia.expect(tipo).to.eql(expectedType);
  }
);

insomnia.test(`${caseId} - Backend informado`, () => {
  insomnia.expect(backend).to.eql('00638');
});
