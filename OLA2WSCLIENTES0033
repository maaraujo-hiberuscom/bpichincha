  insomnia.expect(body).to.match(
    /<mensaje>\s*OK\s*<\/mensaje>/i
  );
});

insomnia.test('Legado - Datos económicos informados', () => {
  insomnia.expect(body).to.include('<detalleEconomicos>');
  insomnia.expect(body).to.include('<ingresos>');
