const config = {
  caseId: 'EP-001',
  expectedCode: '0',
  expectedMessage: 'OK'
};

const body = insomnia.response.text();

function getTagValue(tagName) {
  const regex = new RegExp(
    `<(?:(?:[\\w.-]+):)?${tagName}(?:\\s[^>]*)?>` +
    `\\s*([^<]*)\\s*` +
    `<\\/(?:(?:[\\w.-]+):)?${tagName}\\s*>`,
    'i'
  );

  const result = body.match(regex);
  return result ? result[1].trim() : '';
}

function normalizeMessage(value) {
  return String(value || '')
    .replace(/^(?:TCSBRKR\\d+_BP[-:]?)+/i, '')
    .normalize('NFD')
    .replace(/[\\u0300-\\u036f]/g, '')
    .replace(/\\s+/g, ' ')
    .trim()
    .toLowerCase();
}

const codigo = getTagValue('codigo');
const mensaje = getTagValue('mensaje');

const status =
  insomnia.response.code ??
  insomnia.response.status;

insomnia.test(`${config.caseId} - HTTP exitoso`, () => {
  insomnia.expect(
    status === 200 ||
    status === '200' ||
    status === 'OK'
  ).to.eql(true);
});

insomnia.test(`${config.caseId} - Respuesta SOAP`, () => {
  insomnia.expect(body).to.match(
    /<(?:[\w.-]+:)?Envelope(?:\s|>)/i
  );
});

insomnia.test(`${config.caseId} - Sin SOAP Fault`, () => {
  insomnia.expect(body).not.to.match(
    /<(?:[\w.-]+:)?Fault(?:\s|>)/i
  );
});

insomnia.test(
  `${config.caseId} - Código esperado`,
  () => {
    insomnia.expect(codigo).to.eql(
      config.expectedCode
    );
  }
);

insomnia.test(
  `${config.caseId} - Mensaje esperado`,
  () => {
    insomnia.expect(
      normalizeMessage(mensaje)
    ).to.eql(
      normalizeMessage(config.expectedMessage)
    );
  }
);
